# Kopier til .env og fyll inn

# Port og adresse serveren lytter på (0.0.0.0 = tilgjengelig fra andre maskiner)
PORT=8787
HOST=0.0.0.0

# Adressen folk når serveren på (brukes til Discord-innlogging). Lokalt: http://localhost:8787
PUBLIC_URL=http://localhost:8787

# Discord-appen (samme som launcheren). Secret finner du under OAuth2 i Discord Developer Portal.
DISCORD_CLIENT_ID=833800432866295868
DISCORD_CLIENT_SECRET=

# Discord-ID-ene til eierne (kommaseparert). De kan alltid logge inn og gi andre roller.
ADMIN_DISCORD_IDS=

# Valgfritt: lang tilfeldig streng som signerer innlogginger. Tom = lages automatisk og lagres i databasen.
SESSION_SECRET=

# Valgfritt: annen mappe for db.json
# DATA_DIR=data
